{
  "name": "unknot",
  "version": "0.3.0",
  "description": "Architecture-aware incremental codebase simplification with verification and recovery.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "refactoring",
    "software-architecture",
    "static-analysis",
    "monolith",
    "modernization",
    "technical-debt"
  ],
  "homepage": "https://github.com/QuintinBotes/unknot#readme",
  "bugs": {
    "url": "https://github.com/QuintinBotes/unknot/issues"
  },
  "bin": {
    "unknot": "bin/unknot"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 \"tests/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:adversarial": "node --test \"tests/adversarial/**/*.test.mjs\"",
    "test:golden": "node --test \"tests/golden/**/*.test.mjs\"",
    "bench": "node scripts/bench.mjs",
    "validate": "claude plugin validate --strict ."
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuintinBotes/unknot.git"
  }
}
