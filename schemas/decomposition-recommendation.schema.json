{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unknot.dev/schemas/decomposition-recommendation.schema.json",
  "title": "Decomposition recommendation",
  "description": "Selected treatment for a boundary candidate, with the evidence for and against (spec 15A.8).",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^DEC-\\d{4,}$"
    },
    "target": {
      "enum": [
        "backend",
        "frontend"
      ]
    },
    "driver": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/driver"
      },
      "uniqueItems": true
    },
    "candidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "robust": {
          "type": "boolean"
        },
        "metrics": {
          "type": "object"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "name_basis": {
          "enum": [
            "namespace",
            "directory",
            "route"
          ],
          "description": "How the name was chosen"
        },
        "top_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "description": "Members with the highest fan-in"
        },
        "reverse_dependency_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string"
              },
              "edges": {
                "type": "integer"
              }
            },
            "required": [
              "module",
              "edges"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "folded_siblings": {
          "type": "array",
          "description": "Modules outside the clustered members that only members import and that share a member's directory; folded into the candidate",
          "items": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "module",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "owners": {
          "type": "array",
          "maxItems": 10,
          "description": "Owners of the members and their share of the candidate, so owners.count reads with ownership.alignment",
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string"
              },
              "modules": {
                "type": "integer"
              },
              "share": {
                "type": "number"
              }
            },
            "required": [
              "owner",
              "modules",
              "share"
            ],
            "additionalProperties": false
          }
        },
        "unowned_modules": {
          "type": "integer",
          "description": "Members with no recorded owner"
        },
        "robustness_detail": {
          "type": "object",
          "description": "Why a candidate below the robustness threshold is not robust: the runs that moved members",
          "properties": {
            "stability": {
              "type": "number"
            },
            "threshold": {
              "type": "number"
            },
            "broken_by": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "run": {
                    "type": "string"
                  },
                  "seed": {
                    "type": "integer"
                  },
                  "moved": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "moved_total": {
                    "type": "integer"
                  }
                },
                "required": [
                  "run",
                  "seed",
                  "moved",
                  "moved_total"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "broken_by"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "modules",
        "robust",
        "metrics"
      ],
      "additionalProperties": false
    },
    "treatment": {
      "$ref": "#/$defs/treatment"
    },
    "favoring_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signal": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "source": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "description": "Module or edge ids the signal was measured on"
          }
        },
        "required": [
          "signal",
          "value",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "contraindications_checked": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "value": {}
        },
        "required": [
          "id",
          "result",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "rejected_treatments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "treatment": {
            "$ref": "#/$defs/treatment"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "failed_predicates": {
            "type": "array",
            "description": "Predicates the treatment failed, in the order the reason leads with them",
            "items": {
              "type": "object",
              "properties": {
                "signal": {
                  "type": "string"
                },
                "value": {},
                "op": {
                  "type": "string"
                },
                "threshold": {}
              },
              "required": [
                "signal",
                "value",
                "op",
                "threshold"
              ],
              "additionalProperties": false
            }
          },
          "evidence_needed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Signals not measured that the treatment's decision waits on"
          }
        },
        "required": [
          "treatment",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "first_slice": {
      "type": "object"
    },
    "proof_obligations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^PO-\\d+$"
          },
          {
            "$ref": "proof-obligation.schema.json#/$defs/obligation"
          },
          {
            "$ref": "proof-obligation.schema.json#/$defs/kind"
          }
        ]
      }
    },
    "recovery": {
      "$ref": "slice.schema.json#/$defs/recovery"
    },
    "irreversible": {
      "type": "boolean"
    },
    "retain_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "heuristics_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of target, sorted drivers and sorted candidate module ids; a rerun with the same fingerprint reuses the id"
    },
    "graph_generation": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matched": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "entries",
        "matched",
        "total"
      ],
      "additionalProperties": false
    },
    "driver_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "driver": {
            "$ref": "#/$defs/driver"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "quote": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "driver",
          "source",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "readiness": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "treatment": {
            "$ref": "#/$defs/treatment"
          },
          "kind": {
            "enum": [
              "applicability",
              "precondition",
              "contraindication"
            ]
          },
          "id": {
            "type": "string"
          },
          "signal": {
            "type": "string"
          },
          "value": {},
          "op": {
            "type": "string"
          },
          "threshold": {},
          "met": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "missing_evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "treatment",
          "signal",
          "value",
          "op",
          "threshold",
          "met",
          "missing_evidence"
        ],
        "additionalProperties": false
      }
    },
    "selection_reason": {
      "type": "string",
      "description": "Why this treatment was chosen and why retaining was not (non-retain records)"
    },
    "retain_reason": {
      "type": "string",
      "description": "Why the boundary is retained (T0 records only)"
    },
    "drivers_not_served": {
      "type": "array",
      "description": "Recorded drivers the chosen treatment does not serve although a more invasive treatment would",
      "items": {
        "type": "object",
        "properties": {
          "driver": {
            "$ref": "#/$defs/driver"
          },
          "would_be_served_by": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/treatment"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "driver",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "target",
    "driver",
    "candidate",
    "treatment",
    "favoring_signals",
    "contraindications_checked",
    "rejected_treatments",
    "evidence_gaps",
    "confidence",
    "first_slice",
    "proof_obligations",
    "recovery",
    "irreversible",
    "retain_score",
    "heuristics_used"
  ],
  "additionalProperties": false,
  "$defs": {
    "treatment": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6",
        "T7",
        "T8",
        "T9"
      ]
    },
    "driver": {
      "enum": [
        "independent_deploy",
        "independent_scale",
        "availability_isolation",
        "security_isolation",
        "team_autonomy",
        "technology_divergence",
        "build_time"
      ]
    }
  }
}
