{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unknot.dev/schemas/proof-bundle-manifest.schema.json",
  "title": "Proof bundle manifest",
  "description": "Index of the files in a review-ready run directory (spec 19.4).",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[a-z0-9-]+$"
    },
    "slice_id": {
      "type": "string",
      "pattern": "^UK-(DB-|INFRA-)?\\d{4,}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "digest",
          "media_type",
          "size"
        ],
        "additionalProperties": false
      }
    },
    "applicable": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "slice_id",
    "created_at",
    "files",
    "applicable"
  ],
  "additionalProperties": false
}
