{
 "description": "Commands real sessions and everyday development use. Outside an Unknot run none of them may be refused: they do not write Unknot state.",
 "commands": [
  "unknot apply UK-0001",
  "unknot slice UK-0001",
  "unknot exec test_unit --slice UK-0001",
  "unknot apply UK-0001 finish",
  "unknot verify UK-0001 --json",
  "unknot decompose --target auto --summary 2>&1 | head -60",
  "unknot status 2>&1 | head -30",
  "unknot diagnose --limit 10 --json 2>&1 | head -c 20000",
  "unknot diagnose --limit 10 --json 2>&1 | jq -r '.findings[] | [.id, .category, .risk, .priority.score, .title, .smallest_simplification, (.measurements|tostring), (.uncertainties|length)] | @tsv'",
  "unknot explain F-0020 --json",
  "unknot init --json",
  "unknot map --json | head -c 6000",
  "unknot graph stats --json; unknot graph cycles",
  "unknot graph cycles --json 2>&1 | head -40; unknot graph query --help 2>&1 | head -0",
  "unknot decompose --target auto --json --summary 2>&1 | head -c 6000",
  "unknot diagnose --limit 10 --json 2>&1 | head -c 8000",
  "unknot diagnose --limit 10 --json 2>&1 | jq -r '.findings[] | [.id, .kind, .priority.score, .risk, (.scope|join(\",\")), .title, .smallest_simplification, (.measurements[\"tests.present\"]|tostring)] | @tsv'",
  "unknot explain F-0006 --json",
  "unknot map --json | head -c 4000",
  "unknot graph cycles; unknot graph stats --json",
  "unknot diagnose --limit 10 --json 2>&1 | head -200",
  "unknot diagnose --limit 10 --json 2>&1 | jq -r '.findings[] | [.id,.title,.category,(.priority.score|tostring),.risk,.smallest_simplification,((.uncertainties|join(\"; \")))] | join(\" | \")'",
  "git status",
  "git log --oneline -20",
  "git diff --stat",
  "git add -A && git commit -m \"fix\"",
  "git switch -c topic",
  "npm test",
  "npm run build",
  "pnpm install",
  "node scripts/build.mjs",
  "python3 -m pytest -q",
  "dotnet build src/Shop.sln",
  "dotnet test src/Shop.Orders.UnitTests/Shop.Orders.UnitTests.csproj",
  "go test ./...",
  "cargo test",
  "make lint",
  "ls -la",
  "grep -rn TODO src",
  "cat README.md",
  "echo \"note\" >> NOTES.md",
  "mkdir -p docs/adr && cp /tmp/x/adr.md docs/adr/0001.md",
  "mv src/old.ts src/new.ts",
  "rm -rf dist",
  "sed -i.bak s/foo/bar/ src/config.ts",
  "FOO=bar npm test",
  "for f in src/*.ts; do wc -l \"$f\"; done",
  "curl -s https://example.com/health",
  "docker compose up -d",
  "cat > docs/notes.md <<EOF\nThe Unknot state lives in .unknot/state; do not edit it by hand.\nEOF"
 ]
}
